# Порты сервисов для деплоя и локального запуска (обязательные, без дефолтов)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL параметры
POSTGRES_PORT=5432
POSTGRES_DB=scheduler_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduler_db
HOST=0.0.0.0

# Ориентиры реакции на аварию, не договорный SLA
RESPONSE_LIMIT_MIN=120
RESPONSE_TARGET_MIN=60

# Общий бюджет поиска OR-Tools на весь дневной план, мс (делится между инженерами)
VRPTW_TOTAL_SEARCH_MS=3000
